#!/bin/sh
set -eu

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" = refs/heads/main ]; then
        printf '%s\n' 'Blocked: pushes to main are prohibited, including deletion and force pushes. Push a task branch and merge through a pull request.' >&2
        exit 1
    fi
done
